    {
      "type": "timeseries",
      "title": "Emails per day, by category",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_AGENT_STATS}"
          },
          "queryText": "SELECT time,\n  SUM(CASE WHEN category = 'urgent' THEN emails ELSE 0 END) AS urgent,\n  SUM(CASE WHEN category = 'work' THEN emails ELSE 0 END) AS work,\n  SUM(CASE WHEN category = 'personal' THEN emails ELSE 0 END) AS personal,\n  SUM(CASE WHEN category = 'purchase' THEN emails ELSE 0 END) AS purchase,\n  SUM(CASE WHEN category = 'unsure' THEN emails ELSE 0 END) AS unsure,\n  SUM(CASE WHEN category = 'info' THEN emails ELSE 0 END) AS info,\n  SUM(CASE WHEN category = 'ads' THEN emails ELSE 0 END) AS ads\nFROM email_daily\nWHERE time >= $__from / 1000 AND time <= $__to / 1000\nGROUP BY time ORDER BY time",
          "rawQueryText": "SELECT time,\n  SUM(CASE WHEN category = 'urgent' THEN emails ELSE 0 END) AS urgent,\n  SUM(CASE WHEN category = 'work' THEN emails ELSE 0 END) AS work,\n  SUM(CASE WHEN category = 'personal' THEN emails ELSE 0 END) AS personal,\n  SUM(CASE WHEN category = 'purchase' THEN emails ELSE 0 END) AS purchase,\n  SUM(CASE WHEN category = 'unsure' THEN emails ELSE 0 END) AS unsure,\n  SUM(CASE WHEN category = 'info' THEN emails ELSE 0 END) AS info,\n  SUM(CASE WHEN category = 'ads' THEN emails ELSE 0 END) AS ads\nFROM email_daily\nWHERE time >= $__from / 1000 AND time <= $__to / 1000\nGROUP BY time ORDER BY time",
          "queryType": "time series",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "none",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "urgent"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "work"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "personal"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "purchase"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "unsure"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "info"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3c7a86"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ads"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8a8d94"
                }
              }
            ]
          }
        ]
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_AGENT_STATS}"
      }
