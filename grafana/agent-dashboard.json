      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_AGENT_STATS}"
          },
          "queryText": "SELECT COALESCE(SUM(emails), 0) FROM email_daily WHERE day = date('now')",
          "rawQueryText": "SELECT COALESCE(SUM(emails), 0) FROM email_daily WHERE day = date('now')",
          "queryType": "table"
