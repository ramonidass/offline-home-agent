{
  "__inputs": [
    {
      "name": "DS_AGENT_STATS",
      "label": "Agent stats (SQLite)",
      "type": "datasource",
      "pluginId": "frser-sqlite-datasource",
      "pluginName": "SQLite"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "frser-sqlite-datasource",
      "name": "SQLite",
      "version": "4.0.0"
    }
  ],
  "title": "Agent",
  "uid": "agent-stats",
  "tags": [
    "agent"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "15m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Triage last OK",
      "description": "Minutes since the last successful triage run, when the stats were exported.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_AGENT_STATS}"
          },
          "queryText": "SELECT minutes_since_ok FROM health",
          "rawQueryText": "SELECT minutes_since_ok FROM health",
          "queryType": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "noValue": "\u2013",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_AGENT_STATS}"
      }
    },
    {
      "type": "stat",
