    {
      "type": "table",
      "title": "Filed quietly by the model, per day",
      "description": "Emails the model sorted as info or ads (no push). If this jumps, check the digest.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_AGENT_STATS}"
          },
          "queryText": "SELECT day AS Day, SUM(quiet) AS 'Filed quietly', SUM(emails) AS 'All emails' FROM email_daily GROUP BY day ORDER BY day DESC LIMIT 30",
          "rawQueryText": "SELECT day AS Day, SUM(quiet) AS 'Filed quietly', SUM(emails) AS 'All emails' FROM email_daily GROUP BY day ORDER BY day DESC LIMIT 30",
          "queryType": "table"
        }
