    {
      "type": "timeseries",
      "title": "Sorted by your rules vs the model",
      "description": "More rules = fewer guesses. A growing 'model' share means it's worth adding rules.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_AGENT_STATS}"
          },
          "queryText": "SELECT time,\n  SUM(CASE WHEN sorted_by = 'rule' THEN emails ELSE 0 END) AS rule,\n  SUM(CASE WHEN sorted_by = 'model' THEN emails ELSE 0 END) AS model\nFROM email_daily\nWHERE time >= $__from / 1000 AND time <= $__to / 1000\nGROUP BY time ORDER BY time",
          "rawQueryText": "SELECT time,\n  SUM(CASE WHEN sorted_by = 'rule' THEN emails ELSE 0 END) AS rule,\n  SUM(CASE WHEN sorted_by = 'model' THEN emails ELSE 0 END) AS model\nFROM email_daily\nWHERE time >= $__from / 1000 AND time <= $__to / 1000\nGROUP BY time ORDER BY time",
          "queryType": "time series",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "none",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "rule"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "model"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_AGENT_STATS}"
